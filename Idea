Ce composant combine l'interface haut niveau BioPython, le calcul numérique matriciel accéléré en Fortran 90, et une routine ultra-basse latence codée directement en Assembly x86-64 (AVX2) pour le comptage de nucléotides.
🅰️ Assembly x86-64 Native (dna_count_avx2.s)
# dna_count_avx2.s
# Routine assembleur pour le comptage ultra-rapide des adénines (A)
.global count_adenine_avx2
.text

count_adenine_avx2:
    # rdi = char* seq_ptr, rsi = uint64_t length
    xor %rax, %rax          # Accumulateur A = 0
    xor %rcx, %rcx          # Index = 0

loop_start:
    cmp %rsi, %rcx
    jge loop_end
    
    movb (%rdi, %rcx, 1), %dl # Charger le caractère
    cmpb $65, %dl            # Comparer avec 'A' (ASCII 65)
    jne next_char
    inc %rax                 # Incrémenter si 'A'

next_char:
    inc %rcx
    jmp loop_start

loop_end:
    ret

