#include <immintrin.h>
#include <cstdint>
#include <cstddef>

extern "C" double calculate_gc_content_avx2(const uint8_t* seq, size_t n) {
    if (n == 0) return 0.0;
    
    const __m256i G = _mm256_set1_epi8('G');
    const __m256i C = _mm256_set1_epi8('C');
    const __m256i g = _mm256_set1_epi8('g');
    const __m256i c = _mm256_set1_epi8('c');
    
    __m256i sum = _mm256_setzero_si256();
    size_t i = 0;
    
    for (; i + 32 <= n; i += 32) {
        __m256i chunk = _mm256_loadu_si256((__m256i*)(seq + i));
        __m256i eqG = _mm256_cmpeq_epi8(chunk, G);
        __m256i eqC = _mm256_cmpeq_epi8(chunk, C);
        __m256i eqg = _mm256_cmpeq_epi8(chunk, g);
        __m256i eqc = _mm256_cmpeq_epi8(chunk, c);
        __m256i total = _mm256_sub_epi8(_mm256_setzero_si256(), 
            _mm256_add_epi8(_mm256_add_epi8(eqG, eqC), _mm256_add_epi8(eqg, eqc)));
        sum = _mm256_add_epi64(sum, _mm256_sad_epu8(total, _mm256_setzero_si256()));
    }
    
    // horizontal sum of 4 x 64-bit lanes
    __m128i lo = _mm256_castsi256_si128(sum);
    __m128i hi = _mm256_extracti128_si256(sum, 1);
    __m128i total128 = _mm_add_epi64(lo, hi);
    uint64_t gc_count = _mm_extract_epi64(total128, 0) + _mm_extract_epi64(total128, 1);
    
    // scalar tail
    for (; i < n; ++i) {
        uint8_t b = seq[i];
        if (b == 'G' || b == 'C' || b == 'g' || b == 'c') gc_count++;
    }
    
    return (double)gc_count / (double)n * 100.0;
}
