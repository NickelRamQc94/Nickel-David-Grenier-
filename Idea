def run_biopython_analysis(dna_str: str):
    """Traitement via BioPython standard."""
    seq = Seq(dna_str)
    print(f"[BioPython] Séquence complémentaire : {seq.complement()}")
    print(f"[BioPython] Séquence inverse complémentaire : {seq.reverse_complement()}")

def call_assembly_kernel(dna_str: str) -> int:
    """Appel de la routine assembleur AVX2 x86-64 compilée en SO/DLL."""
    try:
        # Chargement de la bibliothèque assembleur compilée
        lib = ctypes.CDLL('./dna_count_avx2.so')
        lib.count_adenine_avx2.argtypes = [ctypes.c_char_p, ctypes.c_uint64]
        lib.count_adenine_avx2.restype = ctypes.c_uint64
        
        encoded_seq = dna_str.encode('utf-8')
        count = lib.count_adenine_avx2(encoded_seq, len(dna_str))
        return count
    except Exception as e:
        print(f"[Assembly Kernel] Exécution simulée (ou lib non chargée) : {e}")
        return dna_str.count('A')

def call_fortran_kernel(len_a: int, len_b: int):
    """Appel de la matrice de score Fortran via NumPy C-Types."""
    matrix = np.zeros((len_a, len_b), dtype=np.float64)
    # Simulation du calcul Fortran 90
    for i in range(len_a):
        for j in range(len_b):
            matrix[i, j] = 5.0 if i == j else -4.0
