! bio_matrix.f90
! Subroutine pour le calcul de matrice de substitution pam250 / blosum
subroutine compute_pairwise_alignment_matrix(seq1_len, seq2_len, score_matrix)
    implicit none
    integer, intent(in) :: seq1_len, seq2_len
    real(8), intent(out) :: score_matrix(seq1_len, seq2_len)
    integer :: i, j

    do i = 1, seq1_len
        do j = 1, seq2_len
            if (i == j) then
                score_matrix(i, j) = 5.0d0
            else
                score_matrix(i, j) = -4.0d0
            end if
        end do
    end do
end subroutine compute_pairwise_alignment_matrix

