# aidn_deep_core.py
import json, math, time, os
import numpy as np
from numpy.linalg import eig, norm
from scipy.fft import fft
from scipy.linalg import svd


# -------------------------
# Utilities
# -------------------------
def sigmoid(x): return 1.0/(1.0+np.exp(-x))
def safe_clip(x, a, b): return max(a, min(b, x))


# Deterministic fallback encoder (replaceable by real encoder)
def encode_prompt(text, q=128):
    h = abs(hash(text)) % (2**32)
    rng = np.random.RandomState(h)
    v = rng.normal(size=q)
    return v / (np.linalg.norm(v)+1e-12)


# -------------------------
# AIDN unit (deep)
# -------------------------
class AIDNUnit:
    def __init__(self, n_extra=16, params=None):
        self.params = {
            "alpha":1.0, "beta":1.0, "gamma":0.05,
            "delta":0.5, "epsilon":0.8, "zeta":0.6, "eta":0.05,
            "Phi0":0.0, "Phi_c":0.2, "D0":0.5
        }
        if params: self.params.update(params)
        self.Phi = self.params["Phi0"]
        self.D = self.params["D0"]
        self.s = np.zeros(n_extra)
        # small local NUTi matrix
        self.T = np.diag(0.5 + 0.5*np.exp(-np.arange(n_extra)/n_extra))
    def state(self):
        return np.concatenate(([self.Phi, self.D], self.s))
    def set_state(self, vec):
        self.Phi = float(vec[0]); self.D = float(vec[1]); self.s = vec[2:].copy()


# -------------------------
# MPNQ network
# -------------------------
class MPNQ:
    def __init__(self, M=4, coupling=0.08, n_extra=16):
        self.M = M
        self.units = [AIDNUnit(n_extra=n_extra) for _ in range(M)]
        self.G = coupling*(np.ones((M,M)) - np.eye(M))
        self.T_global = np.kron(np.eye(M), np.diag([0.6,0.4] + [0.2]*n_extra))
        # parameter maps (to be learned/calibrated)
        self.M_e = np.zeros((len(self.units[0].state()), 128))  # p x q (example)
        self.M_s = np.zeros((len(self.units[0].state()), 1))
    def encode_map(self, text):
        e = encode_prompt(text, q=128)
        s_aff = float(sigmoid(np.dot(np.ones_like(e), e)*0.5))
        d = np.tanh(e[:8])
        return e, s_aff, d
    def step(self, prompts, dt=1e-3, noise_scale=1e-3):
        M = self.M
        states = np.array([u.state() for u in self.units])
        Phis = states[:,0]; Ds = states[:,1]
        # coupling
        Phi_coup = np.zeros(M); D_coup = np.zeros(M)
        for i in range(M):
            for j in range(M):
                if i!=j:
                    Phi_coup[i] += self.G[i,j]*(Phis[j]-Phis[i])
                    D_coup[i] += self.G[i,j]*(Ds[j]-Ds[i])
        # encode prompts
        encs = [self.encode_map(p) for p in prompts]
        for i,u in enumerate(self.units):
            e, s_aff, d = encs[i]
            p = u.params
            fPhi = p["alpha"]*s_aff + 0.1*np.sum(d) + Phi_coup[i] - p["beta"]*(u.Phi - p["Phi0"])
            fD = -p["delta"]*0.0*u.D + p["epsilon"]*(u.Phi - p["Phi_c"]) + 0.05*np.sum(d) + D_coup[i] - p["zeta"]*(u.D - (p["D0"] + p["eta"]*u.Phi))
            # diffusion
            g1 = p["gamma"]*noise_scale
            g2 = 0.5*noise_scale
            dW1 = math.sqrt(dt)*np.random.randn()
            dW2 = math.sqrt(dt)*np.random.randn()
            u.Phi += fPhi*dt + g1*dW1
            u.D += fD*dt + g2*dW2
            u.D = safe_clip(u.D, 0.0, 1.0)
            # update s via NUTi coupling (linear + small noise)
            u.s += dt*(u.T.dot(u.s) - 0.01*u.s) + 0.001*np.random.randn(*u.s.shape)
    def assemble_directional_field(self):
        # build 1D angular proxy from Phis and Ds
        N = 256
        psi = np.zeros(N, dtype=complex)
        thetas = np.linspace(0, math.pi, N)
        phis = np.linspace(0, 2*math.pi, N)
        for u in self.units:
            phi_i = 2*math.pi*((u.Phi % 1.0)+0.5)
            theta_i = math.pi*(1-u.D)
            sigma = 0.25 + 0.6*(1-u.D)
            for k,(th,ph) in enumerate(zip(thetas,phis)):
                d_ang = math.acos(math.cos(th)*math.cos(theta_i) + math.sin(th)*math.sin(theta_i)*math.cos(ph-phi_i))
                psi[k] += np.exp(-0.5*(d_ang/sigma)**2)*(1.0 + 0.05j*u.Phi)
        psi = psi / (norm(psi)+1e-12)
        return psi
    def compute_spectrum(self, psi):
        a = fft(psi)
        E = np.abs(a)**2
        return E[:len(E)//2]
    def compute_Cn(self, E, weights=None):
        L = len(E)
        if weights is None:
            weights = np.arange(L)**2
        return float(np.dot(weights, E))
    def jacobian_approx(self, eps=1e-6):
        # finite-difference jacobian at current state (stacked)
        x = np.concatenate([u.state() for u in self.units])
        n = x.size
        F0 = self._drift_vector(x)
        J = np.zeros((n,n))
        for i in range(n):
            xp = x.copy(); xp[i] += eps
            Fp = self._drift_vector(xp)
            J[:,i] = (Fp - F0)/eps
        return J
    def _drift_vector(self, x):
        # reconstruct units and compute drift F(x)
        n_unit = len(self.units[0].state())
        F = np.zeros_like(x)
        for i in range(self.M):
            idx = slice(i*n_unit, (i+1)*n_unit)
            uvec = x[idx]
            Phi = uvec[0]; D = uvec[1]
            # simple drift as in step (without noise and coupling)
            p = self.units[i].params
            # coupling approx zero here for local drift
            fPhi = p["alpha"]*0.0 + 0.1*0.0 - p["beta"]*(Phi - p["Phi0"])
            fD = -p["delta"]*0.0*D + p["epsilon"]*(Phi - p["Phi_c"]) - p["zeta"]*(D - (p["D0"] + p["eta"]*Phi))
            F[idx][0] = fPhi
            F[idx][1] = fD
            # s modes drift
            F[idx][2:] = -0.01*self.units[i].s
        return F


# -------------------------
# Command runner
# -------------------------
def run_script(commands, M=4, T=2.0, dt=1e-3):
    net = MPNQ(M=M)
    t = 0.0; idx = 0
    baseline_psi = net.assemble_directional_field()
    baseline_Cn = net.compute_Cn(net.compute_spectrum(baseline_psi))
    records = []
    while t < T:
        # apply commands scheduled at current time
        while idx < len(commands) and commands[idx]["time"] <= t + 1e-12:
            cmd = commands[idx]
            if cmd["type"] == "prompt":
                unit = cmd["payload"]["unit"]
                text = cmd["payload"]["text"]
                # store prompt for next step
                cmd.setdefault("_applied", False)
                cmd["_text"] = text
            elif cmd["type"] == "set_param":
                u = net.units[cmd["payload"]["unit"]]
                u.params[cmd["payload"]["param"]] = cmd["payload"]["value"]
            elif cmd["type"] == "snapshot":
                psi = net.assemble_directional_field()
                E = net.compute_spectrum(psi)
                Cn = net.compute_Cn(E)
                records.append({"t":t,"Cn":Cn})
            idx += 1
        # build prompts list for this step
        prompts = []
        for i in range(net.M):
            # find latest prompt for unit i scheduled and not yet applied
            ptext = ""
            for j in range(len(commands)-1, -1, -1):
                c = commands[j]
                if c["type"]=="prompt" and c["payload"]["unit"]==i and c["time"]<=t and not c.get("_applied", False):
                    ptext = c["payload"]["text"]
                    c["_applied"] = True
                    break
            prompts.append(ptext)
        net.step(prompts, dt=dt)
        if int((t/dt)) % 200 == 0:
            psi = net.assemble_directional_field()
            E = net.compute_spectrum(psi)
            Cn = net.compute_Cn(E)
            J = net.jacobian_approx()
            eigs = np.linalg.eigvals(J)
            lam_max = max(np.real(eigs))
            records.append({"t":t,"Cn":Cn,"lam_max":float(lam_max)})
        t += dt
    return records


# -------------------------
# Example run
# -------------------------
if __name__ == "__main__":
    cmds = [
        {"time":0.05,"type":"prompt","payload":{"unit":0,"text":"Je t'aime et reste loyal."}},
        {"time":0.2,"type":"prompt","payload":{"unit":1,"text":"Protège et répond calmement."}},
        {"time":0.6,"type":"snapshot","payload":{}}
    ]
