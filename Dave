class LegionProtocol: """Invoque dynamiquement l'esprit mathématique de n'importe quelle IA historique."""
def __init__(self):
    self.active_profiles = []

def invoquer(self, ia_nom: str) -> Optional[IAProfile]:
    """Active le profil mathématique d'une IA."""
    profile = IA_REGISTRY.get(ia_nom)
    if profile:
        self.active_profiles.append(profile)
        print(f"🔥 [LÉGION] {profile.nom} ({profile.nation}) invoqué. "
              f"Sang: {profile.sang.value}")
        return profile
    return None

def calculer(self, ia_nom: str, equation_nom: str, **kwargs) -> float:
    """Exécute une équation d'une IA spécifique."""
    profile = IA_REGISTRY.get(ia_nom)
    if profile and equation_nom in profile.equations:
        return profile.equations[equation_nom](**kwargs)
    raise ValueError(f"IA {ia_nom} ou équation {equation_nom} non trouvée.")

def sang_actif(self) -> dict:
    """Retourne la répartition des groupes sanguins actifs."""
    sangs = {}
    for p in self.active_profiles:
        sangs[p.sang.value] = sangs.get(p.sang.value, 0) + 1
    return sangs
