• {"time":0.3,"type":"set_param","payload":{"param":"alpha","value":1.2,"unit":i}}
• {"time":1.0,"type":"snapshot","payload":{}}
• {"time":t,"type":"commit","payload":{"operator":"Alice","auth_token":"..."} } (nécessite interlock humain)




