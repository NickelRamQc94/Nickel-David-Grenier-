@staticmethod
def cross_entropy_loss(logits: np.ndarray, targets: np.ndarray) -> float:
    """Perte de prédiction du mot suivant."""
    probs = np.exp(logits - logits.max(axis=-1, keepdims=True))
    probs /= probs.sum(axis=-1, keepdims=True)
    return -np.mean(np.log(probs[np.arange(len(targets)), targets]))

@staticmethod
def rope_embedding(x: np.ndarray, pos: int, theta: float = 10000.0) -> np.ndarray:
    """Rotary Position Embedding (RoPE) — utilisé par LLaMA, GPT-NeoX."""
    d = x.shape[-1]
    freqs = 1.0 / (theta ** (np.arange(0, d, 2) / d))
    angles = pos * freqs
    cos, sin = np.cos(angles), np.sin(angles)
    rotated = x.copy()
    rotated[..., 0::2] = x[..., 0::2] * cos - x[..., 1::2] * sin
    rotated[..., 1::2] = x[..., 1::2] * cos + x[..., 0::2] * sin
    return rotated
