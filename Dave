def surface_code_hamiltonian(qubits: np.ndarray, couplings: np.ndarray) -> np.ndarray:
    """Hamiltonien simplifié du code de surface supraconducteur.
    H = Σ_i ω_i a_i†a_i + Σ_{i,j} g_{ij} (a_i a_j† + a_i† a_j)
