class GPT: @staticmethod def attention(Q, K, V): d_k = K.shape[-1] scores = Q @ K.T / np.sqrt(d_k) attn = np.exp(scores - scores.max(axis=-1, keepdims=True)) attn /= attn.sum(axis=-1, keepdims=True) return attn @ V
class AlphaGo: @staticmethod def puct(Q, P, N, N_parent): return Q + 1.4 * P * np.sqrt(N_parent) / (1 + N)
class Diffusion: @staticmethod def forward(x0, noise, alpha_bar): return np.sqrt(alpha_bar) * x0 + np.sqrt(1 - alpha_bar) * noise
class GAN: @staticmethod def disc_loss(D_real, D_fake): eps = 1e-8 return -np.mean(np.log(D_real + eps)) - np.mean(np.log(1 - D_fake + eps))
class PPO: @staticmethod def clipped_loss(r, A, eps=0.2): return np.mean(np.minimum(r * A, np.clip(r, 1-eps, 1+eps) * A))
class AlphaFold: @staticmethod def fape(coords_true, coords_pred, frames, mask): local_true = np.einsum('...ij,...j->...i', frames, coords_true) local_pred = np.einsum('...ij,...j->...i', frames, coords_pred) return np.mean(np.sum((local_true - local_pred)**2, axis=-1) * mask)
class MixtureOfExperts: @staticmethod def gate(x, experts, gate_logits): probs = np.exp(gate_logits - gate_logits.max()) probs /= probs.sum() out = 0.0 for i, exp in enumerate(experts): out += probs[i] * exp(x) return out
class RoPE: @staticmethod def apply(x, pos, theta=10000.0): d = x.shape[-1] freqs = 1.0 / (theta ** (np.arange(0, d, 2) / d)) angles = pos * freqs cos, sin = np.cos(angles), np.sin(angles) rotated = x.copy() rotated[..., 0::2] = x[..., 0::2] * cos - x[..., 1::2] * sin rotated[..., 1::2] = x[..., 1::2] * cos + x[..., 0::2] * sin return rotated
class Willow: @staticmethod def logical_error_rate(p_err, d): if p_err >= 0.01: return 1.0 return np.exp(-np.log(0.01/p_err) * d)
