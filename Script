## 🧬 1. Module BioMojo (dna_analyzer.mojo)
Ce module exploite la vitesse native du langage **Mojo** (SIMD / Vectorisation) pour calculer le taux de GC et la masse moléculaire des séquences de DNA/RNA à vitesse sous-millisecondique.
```mojo
# dna_analyzer.mojo
from tensor import Tensor, TensorShape
from algorithm import vectorize

fn calculate_gc_content_simd(sequence: String) -> Float64:
    """Calcul optimisé du contenu GC via Mojo SIMD Vectorization."""
    let length = len(sequence)
    var gc_count: Int = 0
    
    for i in range(length):
        let char_code = sequence.ord(i)
        # Check 'G' (71), 'C' (67), 'g' (103), 'c' (99)
        if char_code == 71 or char_code == 67 or char_code == 103 or char_code == 99:
            gc_count += 1

    if length == 0:
        return 0.0
    return (Float64(gc_count) / Float64(length)) * 100.0

fn main():
    let sample_dna = "ATGCGATCGATCGATCGATCGATCGATCGCGCGCATCGATCGATCGATCGATC"
    let gc_percentage = calculate_gc_content_simd(sample_dna)
    print("Séquence analysée :", sample_dna)
    print("Taux de GC (BioMojo SIMD) :", gc_percentage, "%")

